  "narrative": {
    "overview": "This scope documents transient feedback in the native GTK4/libadwaita application. Compact toasts float above the working surface without adding inline error or information rows. They inherit Commander's Carelo palette and bundled Lucide icons.",
    "dos": [
      "Do route transient errors, information, and completion feedback through the shared notification helpers, including dialog feedback.",
      "Do keep normal counts, progress, metadata, static field instructions, durable reports, and safety confirmations in their existing content surfaces."
    ],
    "donts": [
      "Don't add inline error or information rows, or open a modal merely to report a transient failure.",
      "Don't use toast dismissal as a reason to erase invalid-field diagnostics or durable operation records."
    ]
  }
